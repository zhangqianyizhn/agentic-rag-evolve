# DeepRead question-answering model: keep fixed when comparing repairs to baseline.
DEEPREAD_LLM_API_KEY=
DEEPREAD_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPREAD_LLM_MODEL=

# Framework model: diagnosis, aggregation, planning, code modification and LLM judge.
# Can use a stronger model and a different OpenAI-compatible endpoint/account.
EVOLUTION_LLM_API_KEY=
EVOLUTION_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EVOLUTION_LLM_MODEL=
EVOLUTION_LLM_MAX_OUTPUT_TOKENS=65536
# Explicit CLI output limits take precedence. The target keeps its frozen defaults.

# Legacy .env files still work. Each role falls back to the complete LLM_* group
# ONLY when its own MODEL, BASE_URL and API_KEY are all absent/empty.
# If any role-specific endpoint field is set, all three must be provided.
# LLM_API_KEY=
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=
# LLM_MAX_OUTPUT_TOKENS=65536

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL_NAME=
EMBEDDING_DIMENSION=2048

# Optional; semantic retrieval falls back to stage-one ranking when omitted.
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=
