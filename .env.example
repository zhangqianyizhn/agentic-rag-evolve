# Provider transport settings are loaded only by the stable runner.
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=
# Framework chat calls (judge/diagnosis/planning); explicit CLI limits take precedence.
# The frozen DeepRead baseline transport keeps its original output settings.
LLM_MAX_OUTPUT_TOKENS=65536

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL_NAME=
EMBEDDING_DIMENSION=2048

# Optional; semantic retrieval falls back to stage-one ranking when omitted.
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=
